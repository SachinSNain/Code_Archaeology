# GitHub (personal access token with repo read scope)
GITHUB_TOKEN=

# LLM providers — only the ones you have keys for need to be filled in
GROQ_API_KEY=                       # Primary dev model — free at console.groq.com
ANTHROPIC_API_KEY=                  # Demo/benchmark — console.anthropic.com
OPENAI_API_KEY=                     # Benchmark only — optional
GOOGLE_API_KEY=                     # Benchmark only — optional

# LLM config — change these to switch providers without touching code
LLM_PROVIDER=groq                   # groq | anthropic | openai | google
LLM_MODEL=llama-3.3-70b-versatile   # model name for chosen provider
CLASSIFIER_LLM_PROVIDER=groq        # provider for the query classifier's rare LLM fallback
CLASSIFIER_LLM_MODEL=llama-3.1-8b-instant

# Cohere (reranker — free tier at dashboard.cohere.com)
COHERE_API_KEY=

# Voyage (code embeddings — free tier at dash.voyageai.com)
VOYAGE_API_KEY=

# Execution mode: local (BGE-M3 for everything, no Voyage needed) | hybrid
# (Voyage for code_chunks + one LLM call for synthesis) | benchmark (runs the
# full provider/embedding comparison — costs money, run once)
EXECUTION_MODE=local

# PostgreSQL
POSTGRES_URL=postgresql+psycopg://archaeology:archaeology@localhost:5432/archaeology

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=archaeology_dev_password

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis (answer cache)
REDIS_URL=redis://localhost:6379

# LangSmith (observability — enable from day one)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=code-archaeology-agent
LANGCHAIN_API_KEY=

# Local working dirs
REPO_CLONE_DIR=./data/repos
